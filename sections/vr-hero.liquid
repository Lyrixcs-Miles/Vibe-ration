<section class="vr-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width vr-hero__grid vr-hero__grid--image">
    <div class="vr-hero__copy">
      {% if section.settings.eyebrow != blank %}<p class="vr-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | escape }}{% if section.settings.heading_emphasis != blank %}<span class="vr-hero__emphasis">{{ section.settings.heading_emphasis | escape }}</span>{% endif %}</h1>
      <div class="rte vr-lead">{{ section.settings.text }}</div>
      <div class="vr-actions">
        {% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}
        {% if section.settings.secondary_label != blank %}<a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.collections_url }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
      </div>
      {% if section.settings.note != blank %}<p class="vr-hero__note">{{ section.settings.note | escape }}</p>{% endif %}
    </div>
    <div class="vr-hero__visual"><div class="vr-hero__media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 1180px) 540px, (min-width: 990px) 46vw, calc(100vw - 40px)', loading: 'eager', fetchpriority: 'high' }}{% else %}<span class="vr-photo-label">{{ 'vr.general.photo' | t }}</span>{% endif %}</div>{% if section.settings.caption != blank %}<div class="vr-hero__caption"><span>{{ section.settings.caption | escape }}</span><span aria-hidden="true">↗</span></div>{% endif %}</div>
  </div>
</section>
{% schema %}
{
  "name": "VR Hero",
  "tag": "div",
  "class": "vr-section",
  "settings": [
    {"type":"text","id":"heading_emphasis","label":"Second heading line"},
    {"type":"text","id":"note","label":"Small note below buttons"},
    {"type":"text","id":"caption","label":"Image caption"},
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your own kind of comfort"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A little more you."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Considered essentials for your private moments. Discover something that feels right for you.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "This week’s finds"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "VR Hero"
    }
  ]
}
{% endschema %}

<aside class="vr-contact-details"><p class="vr-eyebrow vr-eyebrow--quiet">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div><div class="vr-contact-details__items">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h3>{{ block.settings.heading | escape }}</h3><div class="rte">{{ block.settings.text }}</div>{% if block.settings.link_label != blank and block.settings.link != blank %}<a class="vr-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</div>{% endfor %}</div></aside>
{% schema %}
{
  "name":"VR Contact details",
  "settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A conversation starts here"},{"type":"text","id":"heading","label":"Heading","default":"What can we help with?"},{"type":"richtext","id":"text","label":"Introduction"}],
  "blocks":[{"type":"detail","name":"Contact detail","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"richtext","id":"text","label":"Text"},{"type":"text","id":"link_label","label":"Link label"},{"type":"url","id":"link","label":"Link"}]}],
  "max_blocks":4,
  "presets":[{"name":"VR Contact details"}]
}
{% endschema %}

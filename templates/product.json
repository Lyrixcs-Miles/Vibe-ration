{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "eyebrow": {
          "type": "text",
          "settings": {
            "text": "A little discovery",
            "text_style": "uppercase"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "body",
            "inventory_threshold": 5,
            "show_inventory_quantity": false
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Delivery & returns",
            "icon": "none",
            "content": "<p>Delivery options and costs are shown at checkout. Please read our shipping and refund policies before placing your order.</p>"
          }
        },
        "care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "A little care goes a long way",
            "icon": "none",
            "content": "<p>Follow the care and safety instructions supplied with your item. If you’re unsure about anything, get in touch before use.</p>"
          }
        }
      },
      "block_order": [
        "eyebrow",
        "title",
        "price",
        "inventory",
        "description",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "shipping",
        "care",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 16,
        "padding_bottom": 48
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "A few more discoveries",
        "heading_size": "h1",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 64
      }
    },
    "help": {
      "type": "vr-callout",
      "settings": {
        "eyebrow": "At your own pace",
        "heading": "Have a question about this one?",
        "text": "<p>Take your time. Our help centre is a good place to start.</p>",
        "button_label": "Explore the help centre",
        "button_link": "shopify://pages/help",
        "color_scheme": "scheme-3"
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products",
    "help"
  ]
}

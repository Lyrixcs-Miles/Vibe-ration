<section class="vr-page-intro color-{{ section.settings.color_scheme }} gradient"><div class="page-width"><p class="vr-eyebrow vr-eyebrow--quiet">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | default: page.title | escape }}</h1><div class="rte vr-lead">{{ section.settings.text }}</div></div></section>
{% schema %}
{
  "name": "VR Page introduction",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "VR Page introduction"
    }
  ]
}
{% endschema %}

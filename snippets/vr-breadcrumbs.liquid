{% doc %}
  Renders contextual navigation before a page heading.
  @param {string} title - Current page title
{% enddoc %}
<nav class="vr-breadcrumbs" aria-label="{{ 'vr.pages.breadcrumbs' | t }}">
  <a href="{{ routes.root_url }}">{{ 'vr.pages.home' | t }}</a><span aria-hidden="true">/</span>
  {% if template.name == 'product' %}<a href="{{ routes.all_products_collection_url }}">{{ 'vr.pages.shop' | t }}</a><span aria-hidden="true">/</span>{% endif %}
  <span aria-current="page">{{ title | escape }}</span>
</nav>
